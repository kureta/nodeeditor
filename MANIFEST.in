include README.rst
include LICENSE.rst
include CMakeLists.txt
include pyproject.toml
include setup.py
recursive-include bindings *.h *.xml *.py *.in *.md
recursive-include cmake *.cmake *.cmake.in
recursive-include include *.hpp *.h
recursive-include src *.cpp *.hpp *.h
recursive-include resources *.qrc *.json
exclude build*
exclude .git*
exclude test*
exclude examples*
exclude docs*
